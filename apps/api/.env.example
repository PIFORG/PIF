# MTRS API environment template. Copy to apps/api/.env and fill in the blanks.
# Never commit real values. Secrets below are intentionally empty; generate your own.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/PIF?schema=public
# Integration tests only: a separate database whose name ends in _test (never the dev database).
# E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/PIF_test?schema=public

APP_NAME=Market Trading Room Simulator
APP_FRONTEND_URL=http://localhost:3000
APP_API_URL=http://localhost:3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
# SWAGGER_ENABLED=true
# TRUST_PROXY=false
# LOG_FORMAT=pretty

# Secrets: 32+ random characters each, all different.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# JWT_ACCESS_SECRET_PREVIOUS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=mtrs-api
JWT_AUDIENCE=mtrs-web
JWT_REFRESH_EXPIRES_IN=7d
AUTH_TOKEN_PEPPER=
AUTH_IP_HASH_PEPPER=
# 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

AUTH_EMAIL_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30
MFA_LOGIN_CHALLENGE_EXPIRES_IN_MINUTES=5
EMAIL_CHANGE_TOKEN_EXPIRES_IN_MINUTES=60
AUTH_MAX_SESSIONS=8
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_LIMIT=20
AUTH_LOGIN_MAX_FAILURES=8
AUTH_LOGIN_LOCKOUT_MINUTES=15
# AUTH_ADMIN_MFA_REQUIRED=false

AUTH_REFRESH_COOKIE_NAME=mtrs_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/auth
# AUTH_COOKIE_DOMAIN=

AUTH_TOKEN_RETENTION_DAYS=30
AUTH_AUDIT_RETENTION_DAYS=365
ACCOUNT_PENDING_DELETION_DAYS=30

# ---------------------------------------------------------------------------
# Transactional email (see docs/transactional-email-setup.md)
# ---------------------------------------------------------------------------
# preview = write .eml files to MAIL_PREVIEW_DIR, nothing is sent (development only;
#           rejected at boot when NODE_ENV=production). View with: npm run mail:inbox
# smtp    = deliver through the SMTP relay below (default when unset).
MAIL_TRANSPORT=preview
# MAIL_PREVIEW_DIR=.mail-preview
# MAIL_INBOX_PORT=3025

# SMTP relay (any provider: Brevo, Mailgun, SendGrid, Postmark, Amazon SES, Microsoft 365 ...).
# Port 587 + SMTP_SECURE=false uses STARTTLS; port 465 + SMTP_SECURE=true uses implicit TLS.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
# Defaults to true in production; plaintext SMTP is refused there.
# SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# Must be a sender address/domain verified with your provider (SPF/DKIM aligned). Never a gmail.com spoof.
EMAIL_FROM="Market Trading Room Simulator <no-reply@your-verified-domain.example>"
# MAIL_REPLY_TO=support@your-verified-domain.example
# Shown as "Need help?" in emails only when set.
# EMAIL_SUPPORT_URL=https://your-verified-domain.example/help

# Optional one-time administrator bootstrap (npm run seed:admin). Leave empty otherwise.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_FIRST_NAME=
# ADMIN_BOOTSTRAP_LAST_NAME=
