# =============================================================================# Market Trading Room Simulator - environment template# NOT LOADED BY THE APP. The API reads apps/api/.env (mail settings, SMTP_PASS, etc.) and the# web app reads apps/web/.env.local. Edit those files; changes here have no effect.# Never commit secrets.# =============================================================================NODE_ENV=development# --- Database ---DATABASE_URL=postgresql://nasma:root@localhost:5432/PIF?schema=public# Used only by npm run test:e2e, which wipes every table between tests. The database# name must end in _test; the suite refuses to start otherwise.# E2E_DATABASE_URL=postgresql://mtrs:mtrs_dev_password@localhost:5432/mtrs_test?schema=public# --- Application URLs ---APP_NAME=Market Trading Room SimulatorAPP_FRONTEND_URL=http://localhost:4200APP_API_URL=http://localhost:3002API_PREFIX=api# Comma-separated bare origins (scheme://host[:port]); no wildcards. https is required in production.CORS_ORIGINS=http://localhost:4200# Express "trust proxy". Keep false unless the API sits behind a reverse proxy you control;# otherwise clients can spoof X-Forwarded-For. Allowed: false, a hop count 1-9 (e.g. 1 for a# single proxy), loopback, linklocal or uniquelocal. "true" (trust every hop) is rejected.TRUST_PROXY=false# Log output: "json" (one object per line, with correlationId) or "pretty".# Defaults to json when NODE_ENV=production and pretty otherwise.# LOG_FORMAT=json# Interactive API docs at {APP_API_URL}/api/docs (OpenAPI JSON at /api/docs-json).# Defaults to true outside production and false when NODE_ENV=production; enable in# production only behind access controls you operate.# SWAGGER_ENABLED=true# --- JWT access credentials (min 32 chars in production) ---JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret-32chars-min# JWT_ACCESS_SECRET_PREVIOUS=JWT_ACCESS_EXPIRES_IN=15mJWT_ISSUER=mtrs-apiJWT_AUDIENCE=mtrs-web# --- Opaque refresh / auth tokens ---# Refresh tokens are opaque (NOT JWT). Do not set JWT_REFRESH_SECRET.JWT_REFRESH_EXPIRES_IN=7dAUTH_TOKEN_PEPPER=change-me-to-a-long-random-pepper-secret-32charsAUTH_EMAIL_COOLDOWN_SECONDS=60EMAIL_VERIFICATION_TOKEN_EXPIRES_IN_MINUTES=60PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30MFA_LOGIN_CHALLENGE_EXPIRES_IN_MINUTES=5EMAIL_CHANGE_TOKEN_EXPIRES_IN_MINUTES=60# --- Sessions & rate limits ---AUTH_MAX_SESSIONS=8AUTH_RATE_LIMIT_TTL_SECONDS=60AUTH_RATE_LIMIT_LIMIT=20AUTH_LOGIN_MAX_FAILURES=8AUTH_LOGIN_LOCKOUT_MINUTES=15# RECOMMENDED policy: administrators must enable two-step verification before using admin# routes. Defaults to true when NODE_ENV=production and false otherwise.# AUTH_ADMIN_MFA_REQUIRED=trueAUTH_IP_HASH_PEPPER=change-me-ip-hash-pepper-secret-32chars-min# --- MFA (AES-256-GCM key: 32 bytes as 64 hex chars) ---MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef# --- Cookies (browser refresh) ---AUTH_REFRESH_COOKIE_NAME=mtrs_refreshAUTH_COOKIE_SECURE=falseAUTH_COOKIE_SAME_SITE=laxAUTH_COOKIE_PATH=/api/auth# AUTH_COOKIE_DOMAIN=# --- SMTP / email ---SMTP_HOST=localhostSMTP_PORT=1025SMTP_SECURE=falseSMTP_USER=SMTP_PASS=EMAIL_FROM="Market Trading Room Simulator <noreply@localhost>"# Optional help page linked in email footers. Leave unset if no real support channel exists.# EMAIL_SUPPORT_URL=# --- Admin bootstrap (opt-in CLI only; never commit real values) ---# ADMIN_BOOTSTRAP_EMAIL=admin@example.com# ADMIN_BOOTSTRAP_PASSWORD=# ADMIN_BOOTSTRAP_FIRST_NAME=Platform# ADMIN_BOOTSTRAP_LAST_NAME=Admin# --- Retention (NEEDS LEGAL/CLIENT APPROVAL for production policy) ---# Applied by npm run maintenance -w @mtrs/api (dry run) / -- --apply (deletes).AUTH_TOKEN_RETENTION_DAYS=30AUTH_AUDIT_RETENTION_DAYS=365ACCOUNT_PENDING_DELETION_DAYS=30# --- Frontend (apps/web/.env.local) ---NEXT_PUBLIC_API_URL=http://localhost:3001/apiNEXT_PUBLIC_APP_NAME=Market Trading Room Simulator# Development mail: capture to apps/api/.mail-preview (view with npm run mail:inbox). Never use in production.MAIL_TRANSPORT=preview