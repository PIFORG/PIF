AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/auth
# AUTH_COOKIE_DOMAIN=

# --- SMTP / email ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Market Trading Room Simulator <noreply@localhost>"
# Optional help page linked in email footers. Leave unset if no real support channel exists.
# EMAIL_SUPPORT_URL=

# --- Admin bootstrap (opt-in CLI only; never commit real values) ---
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_FIRST_NAME=Platform
# ADMIN_BOOTSTRAP_LAST_NAME=Admin

# --- Retention (NEEDS LEGAL/CLIENT APPROVAL for production policy) ---
# Applied by npm run maintenance -w @mtrs/api (dry run) / -- --apply (deletes).
AUTH_TOKEN_RETENTION_DAYS=30
AUTH_AUDIT_RETENTION_DAYS=365
ACCOUNT_PENDING_DELETION_DAYS=30

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=Market Trading Room Simulator

# Development mail: capture to apps/api/.mail-preview (view with npm run mail:inbox). Never use in production.
MAIL_TRANSPORT=preview