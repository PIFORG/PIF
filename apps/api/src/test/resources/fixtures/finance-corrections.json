{
  "description": "Independent regression fixtures for the three intentional corrections of the Java financial core. Expected values are derived by hand from the formulas in apps/api/src/finance (worked arithmetic in each 'derivation'), not generated by either implementation. Amounts are millimes.",
  "objectPropertySymbols": {
    "symbols": ["__proto__", "constructor", "toString", "hasOwnProperty", "valueOf", "isPrototypeOf", "propertyIsEnumerable", "toLocaleString", "__defineGetter__"],
    "initialCash": 1000000,
    "buy": { "price": 10000, "quantity": 10, "fee": 500, "mid": 9990 },
    "sell": { "price": 11000, "quantity": 4, "fee": 500, "mid": 11010 },
    "expected": {
      "afterBuy": { "cash": 899500, "quantity": 10, "costBasis": 100500, "spreadCost": 100 },
      "afterSell": { "cash": 943000, "quantity": 6, "costBasis": 60300, "costRemoved": 40200, "realizedPnl": 3300, "feesPaid": 1000, "spreadCostPaid": 140 }
    },
    "derivation": "buy: notional 10000x10 = 100000; cash 1000000 - (100000 + 500) = 899500; cost basis 100500; spread (10000 - 9990) x 10 = 100. sell: notional 11000x4 = 44000; cost removed round(100500 x 4 / 10) = 40200; proceeds 44000 - 500 = 43500; realised 43500 - 40200 = 3300; cash 899500 + 43500 = 943000; cost basis 100500 - 40200 = 60300; spread (11010 - 11000) x 4 = 40, total 140. Identity: cash + cost basis = 943000 + 60300 = 1003300 = 1000000 + 3300."
  },
  "historicalVaR": {
    "valid": {
      "pnl": [-5, -12, -1, -30, -7, -22, -3, -18, -9, -27, -14, -2, -25, -11, -6, -20, -16, -4, -29, -8, -24, -10, -13, -19, -15, -21, -17, -23, -26, -28],
      "expected": { "valueAtRisk": 29, "expectedShortfall": 29.5 },
      "derivation": "n = 30, index = floor((1 - 0.95) x 30) = floor(1.5000000000000013) = 1; sorted[1] = -29 so VaR = 29; tail = sorted[0..1] = [-30, -29], ES = 59 / 2 = 29.5."
    },
    "invalid": [
      { "note": "one NaN among 30 observations", "replaceIndex": 4, "with": "NaN" },
      { "note": "positive infinity", "replaceIndex": 0, "with": "Infinity" },
      { "note": "negative infinity", "replaceIndex": 29, "with": "-Infinity" }
    ],
    "insufficientWithNaN": { "note": "29 observations, one NaN: too few observations is reported first (null), as before", "size": 29, "replaceIndex": 3 }
  },
  "maxWeight": {
    "large": {
      "holdings": 200000,
      "valueEach": 1000,
      "largest": 7000,
      "cash": 3000,
      "derivation": "base = 200000 x 1000 + 7000 + 3000 = 200010000; largest weight = 7000 / 200010000, one correctly rounded division."
    },
    "ordinary": { "values": { "CTB": 30000, "GOV": 50000 }, "base": 100000, "expected": 0.5 },
    "noHoldings": { "base": 100000, "expected": 0 },
    "nonPositiveBase": [0, -1]
  }
}
