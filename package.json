{
  "name": "market-trading-room-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "PIF MarketLab \u2014 Angular (apps/web) + Spring Boot (apps/api) + PostgreSQL.",
  "workspaces": [
    "apps/web",
    "packages/*",
    "tools/db-harness"
  ],
  "scripts": {
    "dev:web": "npm start -w @mtrs/web",
    "dev:api": "cd apps/api && .\\\\mvnw.cmd spring-boot:run",
    "build": "npm run build -w @mtrs/web",
    "build:web": "npm run build -w @mtrs/web",
    "build:api": "cd apps/api && .\\\\mvnw.cmd -q -DskipTests package",
    "test": "npm run test -w @mtrs/web",
    "test:web": "npm run test -w @mtrs/web",
    "test:api": "cd apps/api && .\\\\mvnw.cmd -B -P database-tests test",
    "lint": "npm run lint -w @mtrs/web",
    "typecheck": "npm run typecheck -w @mtrs/web",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:journey:auth": "node scripts/migration/angular-auth-journey.mjs",
    "test:journey:trading": "node scripts/migration/angular-trading-journey.mjs",
    "test:journey:learning": "node scripts/migration/angular-learning-journey.mjs",
    "test:journey:actuarial": "node scripts/migration/angular-actuarial-journey.mjs",
    "test:openapi": "node scripts/migration/openapi-compare.mjs",
    "test:visual": "node scripts/migration/visual-parity.mjs",
    "harness:generate": "npm run harness:generate -w @pif/db-harness"
  },
  "engines": {
    "node": ">=20"
  }
}
